<script setup>
import { ref, computed, onMounted } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import axios from 'axios'

const API_BASE = 'http://localhost:8000'

const instances = ref([])
const loading = ref(false)
const metricsVisible = ref(false)
const currentMetrics = ref(null)
const currentInstance = ref(null)

const totalMonthlyCost = computed(() => {
  return instances.value.reduce((sum, inst) => sum + (inst.monthly_cost || 0), 0).toFixed(2)
})

const runningCount = computed(() => {
  return instances.value.filter(i => i.status === 'running').length
})

const getStatusType = (status) => {
  const map = {
    'running': 'success',
    'pending': 'warning',
    'stopped': 'info',
    'error': 'danger'
  }
  return map[status] || 'info'
}

const getProgressColor = (percentage) => {
  if (percentage < 50) return '#67c23a'
  if (percentage < 80) return '#e6a23c'
  if (percentage < 90) return '#f56c6c'
  return '#ff0000'
}

onMounted(() => {
  refreshList()
})

const refreshList = async () => {
  loading.value = true
  try {
    const res = await axios.get(`${API_BASE}/api/instances`)
    instances.value = res.data
  } catch (e) {
    ElMessage.error('获取实例列表失败')
  } finally {
    loading.value = false
  }
}

const openAllPorts = async (row) => {
  try {
    await ElMessageBox.confirm(
      `确定要开放 ${row.name} 的所有端口吗？这将暴露所有服务到公网`,
      '安全警告',
      { confirmButtonText: '确认开放', cancelButtonText: '取消', type: 'warning' }
    )
    
    const res = await axios.post(`${API_BASE}/api/instances/${row.name}/open-all-ports`)
    ElMessage.success(res.data.message)
  } catch (e) {
    if (e !== 'cancel') {
      ElMessage.error('操作失败: ' + (e.response?.data?.detail || e.message))
    }
  }
}

const closeAllPorts = async (row) => {
  try {
    const res = await axios.post(`${API_BASE}/api/instances/${row.name}/close-all-ports?keep_ssh=true`)
    ElMessage.success(res.data.message)
  } catch (e) {
    ElMessage.error('操作失败')
  }
}

const viewMetrics = async (row) => {
  currentInstance.value = row
  try {
    const res = await axios.get(`${API_BASE}/api/instances/${row.name}/metrics`)
    currentMetrics.value = res.data
    metricsVisible.value = true
  } catch (e) {
    ElMessage.error('获取流量数据失败')
  }
}

const deleteInstance = async (row) => {
  try {
    await axios.delete(`${API_BASE}/api/instances/${row.name}`)
    ElMessage.success('删除成功')
    refreshList()
  } catch (e) {
    ElMessage.error('删除失败')
  }
}
</script>

