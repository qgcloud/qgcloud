<script setup>
import { ref, reactive, computed, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import axios from 'axios'

const API_BASE = 'http://localhost:8000'

const formRef = ref()
const config = ref({ regions: {}, bundles: {}, blueprints: {}, network_types: {} })
const availableZones = ref([])
const priceInfo = ref(null)
const creating = ref(false)
const progressVisible = ref(false)
const createProgress = ref(0)
const createStatus = ref('')
const progressText = ref('')
const enablePassword = ref(false)
const enableUserData = ref(false)

const form = reactive({
  region: '',
  availability_zone: '',
  bundle_id: '',
  network_type: 'dual_stack',
  blueprint_id: '',
  count: 1,
  name_prefix: 'worker',
  password: '',
  user_data: ''
})

const rules = {
  region: [{ required: true, message: '请选择区域', trigger: 'change' }],
  availability_zone: [{ required: true, message: '请选择可用区', trigger: 'change' }],
  bundle_id: [{ required: true, message: '请选择配置', trigger: 'change' }],
  blueprint_id: [{ required: true, message: '请选择操作系统', trigger: 'change' }],
  count: [{ required: true, message: '请输入数量', trigger: 'blur' }]
}

const linuxBlueprints = computed(() => {
  return Object.fromEntries(
    Object.entries(config.value.blueprints || {}).filter(([_, v]) => v.type === 'linux')
  )
})

const windowsBlueprints = computed(() => {
  return Object.fromEntries(
    Object.entries(config.value.blueprints || {}).filter(([_, v]) => v.type === 'windows')
  )
})

onMounted(async () => {
  try {
    const res = await axios.get(`${API_BASE}/api/config`)
    config.value = res.data
  } catch (e) {
    ElMessage.error('获取配置失败')
  }
})

const handleRegionChange = (val) => {
  availableZones.value = config.value.regions[val]?.zones || []
  form.availability_zone = ''
}

const calculatePrice = async () => {
  if (!form.bundle_id || !form.network_type) return
  
  try {
    const res = await axios.post(`${API_BASE}/api/calculate-price`, {
      bundle_id: form.bundle_id,
      network_type: form.network_type,
      count: form.count,
      region: form.region
    })
    priceInfo.value = res.data
  } catch (e) {
    ElMessage.error('价格计算失败')
  }
}

const submitCreate = async () => {
  await formRef.value.validate()
  
  creating.value = true
  progressVisible.value = true
  createProgress.value = 0
  createStatus.value = ''
  progressText.value = '正在创建实例...'

  try {
    const submitData = { ...form }
    if (!enablePassword.value) delete submitData.password
    if (!enableUserData.value) delete submitData.user_data

    const res = await axios.post(`${API_BASE}/api/instances/create`, submitData)
    
    createProgress.value = 100
    createStatus.value = 'success'
    progressText.value = `成功创建 ${res.data.created} 台实例，月度费用 $${res.data.total_cost}`
    
    ElMessage.success('创建成功')
    setTimeout(() => {
      progressVisible.value = false
      window.location.href = '/instances'
    }, 2000)
  } catch (e) {
    createStatus.value = 'exception'
    progressText.value = '创建失败: ' + (e.response?.data?.detail || e.message)
    ElMessage.error('创建失败')
  } finally {
    creating.value = false
  }
}

const resetForm = () => {
  formRef.value.resetFields()
  priceInfo.value = null
}
</script>

