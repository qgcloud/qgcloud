# 计算价格接口
@app.post("/api/calculate-price")
def calculate_price(request: dict):
    """计算批量创建的总价格"""
    bundle = INSTANCE_BUNDLES.get(request["bundle_id"])
    network = NETWORK_TYPES.get(request["network_type"])
    
    if not bundle or not network:
        raise HTTPException(status_code=400, detail="无效的配置")
    
    # 根据网络类型选择价格
    unit_price = bundle["ipv6_price"] if not network["has_ipv4"] else bundle["ipv4_price"]
    total = unit_price * request["count"]
    
    # 亚太地区流量减半警告[^37^]
    region = request["region"]
    is_ap = any(x in region for x in ["ap-", "mumbai", "sydney", "jakarta"])
    warning = None
    if is_ap:
        warning = "⚠️ 亚太地区流量配额减半（如1TB变500GB），请注意流量成本"
    
    return {
        "unit_price": unit_price,
        "count": request["count"],
        "total_monthly": round(total, 2),
        "bundle_specs": bundle["specs"],
        "transfer_gb": bundle["transfer_gb"] / (2 if is_ap else 1),
        "warning": warning
    }

# 创建实例接口
@app.post("/api/instances/create")
async def create_instances(request: CreateInstanceRequest, background_tasks: BackgroundTasks):
    """批量创建Lightsail实例"""
    try:
        lightsail = boto3.client('lightsail', region_name=request.region)
        
        created_instances = []
        timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
        
        for i in range(request.count):
            instance_name = f"{request.name_prefix}-{timestamp}-{i+1}"
            
            # 构建创建参数
            params = {
                "instanceNames": [instance_name],
                "availabilityZone": request.availability_zone,
                "blueprintId": request.blueprint_id,
                "bundleId": request.bundle_id,
            }
            
            # 添加开机脚本
            user_data = request.user_data or ""
            
            # 如果设置了密码，配置密码连接（仅Linux支持）
            if request.password and OS_BLUEPRINTS[request.blueprint_id]["type"] == "linux":
                # 设置密码的cloud-init脚本
                password_script = f"""#!/bin/bash
echo 'root:{request.password}' | chpasswd
echo 'ec2-user:{request.password}' | chpasswd
sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config
sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config
systemctl restart sshd || service ssh restart
"""
                user_data = password_script + "\n" + user_data
            
            if user_data:
                params["userData"] = user_data
            
            # 执行创建
            response = lightsail.create_instances(**params)
            
            # 获取价格
            bundle = INSTANCE_BUNDLES[request.bundle_id]
            network = NETWORK_TYPES[request.network_type]
            monthly_cost = bundle["ipv6_price"] if not network["has_ipv4"] else bundle["ipv4_price"]
            
            # 保存到数据库
            conn = sqlite3.connect('lightsail_panel.db')
            c = conn.cursor()
            c.execute("""INSERT INTO instances 
                        (id, name, region, bundle_id, blueprint_id, created_at, 
                         status, password, network_type, monthly_cost)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                     (response["operations"][0]["resourceName"], 
                      instance_name, request.region, request.bundle_id,
                      request.blueprint_id, datetime.now().isoformat(),
                      "Pending", request.password, request.network_type, monthly_cost))
            conn.commit()
            conn.close()
            
            created_instances.append({
                "name": instance_name,
                "operation_id": response["operations"][0]["id"]
            })
        
        # 后台任务：轮询创建状态
        background_tasks.add_task(poll_creation_status, request.region, created_instances)
        
        return {
            "success": True,
            "created": len(created_instances),
            "instances": created_instances,
            "total_cost": monthly_cost * request.count
        }
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

async def poll_creation_status(region: str, instances: list):
    """后台轮询实例创建状态"""
    import time
    lightsail = boto3.client('lightsail', region_name=region)
    
    for inst in instances:
        max_retries = 30
        for _ in range(max_retries):
            try:
                response = lightsail.get_instance(instanceName=inst["name"])
                status = response["instance"]["state"]["name"]
                
                conn = sqlite3.connect('lightsail_panel.db')
                c = conn.cursor()
                
                if status == "running":
                    # 更新IP地址
                    public_ip = response["instance"].get("publicIpAddress")
                    private_ip = response["instance"].get("privateIpAddress")
                    ipv6_addrs = json.dumps(response["instance"].get("ipv6Addresses", []))
                    
                    c.execute("""UPDATE instances SET status=?, public_ip=?, 
                                private_ip=?, ipv6_addresses=? WHERE name=?""",
                             (status, public_ip, private_ip, ipv6_addrs, inst["name"]))
                    
                    # 如果是双栈且需要分配静态IP
                    # 这里可以添加静态IP分配逻辑
                    
                else:
                    c.execute("UPDATE instances SET status=? WHERE name=?", 
                             (status, inst["name"]))
                
                conn.commit()
                conn.close()
                
                if status == "running":
                    break
                    
                time.sleep(10)
            except Exception as e:
                print(f"轮询错误 {inst['name']}: {e}")
                time.sleep(10)

# 获取实例列表
@app.get("/api/instances")
def list_instances():
    """获取所有管理的实例"""
    conn = sqlite3.connect('lightsail_panel.db')
    c = conn.cursor()
    c.execute("SELECT * FROM instances ORDER BY created_at DESC")
    rows = c.fetchall()
    conn.close()
    
    instances = []
    for row in rows:
        bundle = INSTANCE_BUNDLES.get(row[3], {})
        os_info = OS_BLUEPRINTS.get(row[4], {})
        instances.append({
            "id": row[0],
            "name": row[1],
            "region": row[2],
            "region_name": AWS_REGIONS.get(row[2], {}).get("name", row[2]),
            "bundle_name": bundle.get("name", row[3]),
            "os_name": os_info.get("name", row[4]),
            "status": row[6],
            "public_ip": row[7],
            "private_ip": row[8],
            "ipv6_addresses": json.loads(row[9]) if row[9] else [],
            "monthly_cost": row[11],
            "created_at": row[5]
        })
    
    return instances

# 批量开放所有端口
@app.post("/api/instances/{instance_name}/open-all-ports")
def open_all_ports(instance_name: str):
    """一键开放实例的所有端口"""
    try:
        # 从数据库获取区域
        conn = sqlite3.connect('lightsail_panel.db')
        c = conn.cursor()
        c.execute("SELECT region FROM instances WHERE name=?", (instance_name,))
        row = c.fetchone()
        conn.close()
        
        if not row:
            raise HTTPException(status_code=404, detail="实例不存在")
        
        region = row[0]
        lightsail = boto3.client('lightsail', region_name=region)
        
        # 构建端口规则：开放所有TCP和UDP
        port_infos = [
            {
                "fromPort": 0,
                "toPort": 65535,
                "protocol": "tcp",
                "accessFrom": "Anywhere",
                "accessType": "public",
                "cidrs": ["0.0.0.0/0"]
            },
            {
                "fromPort": 0,
                "toPort": 65535,
                "protocol": "udp",
                "accessFrom": "Anywhere",
                "accessType": "public",
                "cidrs": ["0.0.0.0/0"]
            },
            {
                "fromPort": -1,
                "toPort": -1,
                "protocol": "icmp",
                "accessFrom": "Anywhere",
                "accessType": "public",
                "cidrs": ["0.0.0.0/0"]
            }
        ]
        
        lightsail.put_instance_public_ports(
            instanceName=instance_name,
            portInfos=port_infos
        )
        
        return {"success": True, "message": f"{instance_name} 所有端口已开放"}
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# 关闭所有端口（流量保护）
@app.post("/api/instances/{instance_name}/close-all-ports")
def close_all_ports(instance_name: str, keep_ssh: bool = True):
    """关闭实例所有端口（用于流量保护）"""
    try:
        conn = sqlite3.connect('lightsail_panel.db')
        c = conn.cursor()
        c.execute("SELECT region FROM instances WHERE name=?", (instance_name,))
        row = c.fetchone()
        conn.close()
        
        if not row:
            raise HTTPException(status_code=404, detail="实例不存在")
        
        region = row[0]
        lightsail = boto3.client('lightsail', region_name=region)
        
        if keep_ssh:
            # 只保留SSH端口
            port_infos = [{
                "fromPort": 22,
                "toPort": 22,
                "protocol": "tcp",
                "accessFrom": "Anywhere",
                "accessType": "public",
                "cidrs": ["0.0.0.0/0"]
            }]
        else:
            port_infos = []
        
        lightsail.put_instance_public_ports(
            instanceName=instance_name,
            portInfos=port_infos
        )
        
        return {"success": True, "message": f"{instance_name} 已关闭所有端口" + ("（保留SSH）" if keep_ssh else "")}
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# 删除实例
@app.delete("/api/instances/{instance_name}")
def delete_instance(instance_name: str):
    """删除实例"""
    try:
        conn = sqlite3.connect('lightsail_panel.db')
        c = conn.cursor()
        c.execute("SELECT region FROM instances WHERE name=?", (instance_name,))
        row = c.fetchone()
        
        if not row:
            conn.close()
            raise HTTPException(status_code=404, detail="实例不存在")
        
        region = row[0]
        
        # 从AWS删除
        lightsail = boto3.client('lightsail', region_name=region)
        lightsail.delete_instance(instanceName=instance_name)
        
        # 从数据库删除
        c.execute("DELETE FROM instances WHERE name=?", (instance_name,))
        conn.commit()
        conn.close()
        
        return {"success": True, "message": f"{instance_name} 已删除"}
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# 获取流量统计（集成CloudWatch）
@app.get("/api/instances/{instance_name}/metrics")
def get_instance_metrics(instance_name: str):
    """获取实例流量统计"""
    try:
        conn = sqlite3.connect('lightsail_panel.db')
        c = conn.cursor()
        c.execute("SELECT region, bundle_id FROM instances WHERE name=?", (instance_name,))
        row = c.fetchone()
        conn.close()
        
        if not row:
            raise HTTPException(status_code=404, detail="实例不存在")
        
        region, bundle_id = row
        bundle = INSTANCE_BUNDLES.get(bundle_id, {})
        quota_gb = bundle.get("transfer_gb", 1000)
        
        # 检查是否亚太地区（配额减半）[^37^]
        is_ap = any(x in region for x in ["ap-", "mumbai", "sydney", "jakarta"])
        actual_quota = quota_gb / 2 if is_ap else quota_gb
        
        # 这里应该调用CloudWatch获取实际流量
        # 简化返回模拟数据，实际实现需要集成CloudWatch
        return {
            "instance": instance_name,
            "monthly_quota_gb": actual_quota,
            "used_gb": 0,  # 需要从CloudWatch获取
            "remaining_gb": actual_quota,
            "usage_percent": 0,
            "is_ap_region": is_ap,
            "warning": is_ap
        }
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

