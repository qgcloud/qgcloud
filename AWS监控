from fastapi import FastAPI, HTTPException, BackgroundTasks
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from typing import List, Optional
import boto3
import sqlite3
import json
from datetime import datetime
from config import AWS_REGIONS, INSTANCE_BUNDLES, OS_BLUEPRINTS, NETWORK_TYPES

app = FastAPI(title="Lightsail控制面板")

# CORS配置
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# 初始化数据库
def init_db():
    conn = sqlite3.connect('lightsail_panel.db')
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS instances
                 (id TEXT PRIMARY KEY, name TEXT, region TEXT, bundle_id TEXT,
                  blueprint_id TEXT, created_at TEXT, status TEXT, 
                  public_ip TEXT, private_ip TEXT, ipv6_addresses TEXT,
                  password TEXT, network_type TEXT, monthly_cost REAL)''')
    conn.commit()
    conn.close()

init_db()

# 数据模型
class CreateInstanceRequest(BaseModel):
    region: str
    availability_zone: str
    bundle_id: str
    blueprint_id: str
    network_type: str = "dual_stack"  # dual_stack 或 ipv6_only
    count: int = Field(1, ge=1, le=20)  # 批量创建最多20台
    password: Optional[str] = None  # 密码连接功能
    user_data: Optional[str] = ""  # 开机脚本
    name_prefix: str = "worker"

class InstanceResponse(BaseModel):
    id: str
    name: str
    region: str
    status: str
    public_ip: Optional[str]
    bundle_name: str
    os_name: str
    monthly_cost: float
    created_at: str

